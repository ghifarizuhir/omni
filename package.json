{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:vite": "NODE_OPTIONS=--max-old-space-size=512 vite --port=3000 --host=0.0.0.0",
    "dev:server": "NODE_OPTIONS=--max-old-space-size=512 tsx watch --clear-screen=false server/index.ts",
    "start": "tsx server/index.ts",
    "start:worker": "tsx server/worker.ts",
    "server": "tsx server/index.ts",
    "server:watch": "NODE_OPTIONS=--max-old-space-size=512 tsx watch --clear-screen=false server/index.ts",
    "dev:all": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:vite\" --kill-others --handle-input",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:seed:prod": "dotenv -e .env.local -- tsx prisma/seed.prod.ts",
    "db:reset": "dotenv -e .env.local -- prisma migrate reset --force --skip-seed && dotenv -e .env.local -- tsx prisma/seed.ts",
    "test": "vitest run",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json && eslint 'server/routes/**/*.ts' --max-warnings 0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@google/genai": "^1.29.0",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.12.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "autoprefixer": "^10.4.21",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.3.0",
    "supertest": "^7.2.2",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.6"
  }
}
