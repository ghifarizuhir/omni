// OIS Prisma schema — pilot domains.
// M7.1: ported from SQLite to Postgres. Dev, staging, and prod all run on
// Postgres now (managed Postgres in cloud envs; docker-compose locally —
// see docs/PRODUCTION-READINESS-STRATEGY.md M7.4).
//
// FUTURE (out of scope for M7.1): the many `data String` columns currently
// hold serialized JSON. Convert them to `Json` (jsonb) and add GIN indexes
// on hot lookup paths (e.g. Incident.data, MonitoringRule.data) once the
// repository layer is updated to read/write structured values instead of
// pre-serialized strings. Tracked as part of M7's hardening work.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identity / Tenancy ────────────────────────────────────────────────────────

model Tenant {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  createdAt   DateTime            @default(now())
  memberships TenantMembership[]
  roles       Role[]
  cis         ConfigurationItem[]
  events      Event[]
  rules       MonitoringRule[]
  routes      AlertRoute[]
  incidents   Incident[]
  divisions      Division[]
  departments    Department[]
  teams          Team[]
  applications   Application[]
  functionalRoles FunctionalRole[]
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String
  avatarUrl    String?
  passwordHash       String?
  mustChangePassword Boolean            @default(false)
  isSuperadmin Boolean            @default(false)
  level        String?
  divisionId   String?
  departmentId String?
  teamId       String?
  createdAt    DateTime           @default(now())
  memberships  TenantMembership[]
  sessions     Session[]
  division     Division?          @relation(fields: [divisionId],   references: [id], onDelete: SetNull)
  department   Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team         Team?              @relation(fields: [teamId],       references: [id], onDelete: SetNull)
  functionalRoles      UserFunctionalRole[]
  apiTokens            ApiToken[]
  notificationChannels NotificationChannel[]
}

model TenantMembership {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  createdAt DateTime         @default(now())
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     MembershipRole[]

  @@unique([tenantId, userId])
}

// ── RBAC (M2: flat role → permission) ────────────────────────────────────────

model Permission {
  key         String           @id // dotted, e.g. "cmdb.write"
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String? // null = system role (admin/operator/...)
  name        String
  description String?
  isSystem    Boolean          @default(false) // built-ins are protected from edit/delete
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, name])
}

model RolePermission {
  roleId        String
  permissionKey String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

model MembershipRole {
  membershipId String
  roleId       String
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
}

model Division {
  id        String   @id
  tenantId  String
  code      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments Department[]
  users       User[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Department {
  id         String   @id
  tenantId   String
  divisionId String
  code       String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  teams    Team[]
  users    User[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([divisionId])
}

model Team {
  id           String   @id
  tenantId     String
  departmentId String
  code         String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users      User[]
  applications ApplicationTeam[]

  @@unique([tenantId, code])
  @@index([departmentId])
}

model Application {
  id          String   @id
  tenantId    String
  code        String
  name        String
  criticality String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teams  ApplicationTeam[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

enum ApplicationTeamRole {
  OWNER
  CONTRIBUTOR
  VIEWER
}

model ApplicationTeam {
  applicationId String
  teamId        String
  role          ApplicationTeamRole @default(CONTRIBUTOR)
  addedById     String?
  addedAt       DateTime            @default(now())
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  team        Team        @relation(fields: [teamId],        references: [id], onDelete: Cascade)

  @@id([applicationId, teamId])
  @@index([teamId])
  @@index([applicationId, role])
}

model FunctionalRole {
  id          String   @id
  tenantId    String
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  UserFunctionalRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model UserFunctionalRole {
  userId           String
  functionalRoleId String
  user User           @relation(fields: [userId],           references: [id], onDelete: Cascade)
  role FunctionalRole @relation(fields: [functionalRoleId], references: [id], onDelete: Cascade)

  @@id([userId, functionalRoleId])
  @@index([functionalRoleId])
}

model Session {
  id        String   @id
  userId    String
  tenantId  String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiToken {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  name       String
  tokenHash  String    @unique
  prefix     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

model NotificationChannel {
  id       String  @id @default(cuid())
  tenantId String
  userId   String
  kind     String
  address  String
  verified Boolean @default(false)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}

// ── CMDB ──────────────────────────────────────────────────────────────────────

model ConfigurationItem {
  id                  String           @id // mirrors mock id when seeded
  publicId            String           @unique
  tenantId            String
  name                String
  type                String
  status              String
  environment         String
  criticality         String
  ownerId             String?
  ownerTeamId         String
  primaryApplicationId String?
  serviceId           String?
  health              String
  attributes          String // JSON
  tags                String // JSON string array
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  lastDiscoveredAt    DateTime?
  openIncidentCount   Int              @default(0)
  recentChangeCount   Int              @default(0)
  monitoringRuleCount Int              @default(0)
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromRelationships   CIRelationship[] @relation("FromCI")
  toRelationships     CIRelationship[] @relation("ToCI")
  auditEntries        CIAuditEntry[]

  @@index([tenantId, type])
  @@index([tenantId, environment])
  @@index([tenantId, primaryApplicationId])
}

model CIRelationship {
  id          String            @id
  tenantId    String
  fromCiId    String
  toCiId      String
  type        String
  description String?
  createdAt   DateTime          @default(now())
  fromCi      ConfigurationItem @relation("FromCI", fields: [fromCiId], references: [id], onDelete: Cascade)
  toCi        ConfigurationItem @relation("ToCI", fields: [toCiId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([fromCiId])
  @@index([toCiId])
}

model CIAuditEntry {
  id          String            @id
  tenantId    String
  ciId        String
  ciPublicId  String
  ciName      String
  action      String
  actorId     String
  actorName   String
  actorType   String
  field       String?
  beforeValue String? // serialized as JSON when not null
  afterValue  String?
  source      String
  description String?
  timestamp   DateTime
  ci          ConfigurationItem @relation(fields: [ciId], references: [id], onDelete: Cascade)

  @@index([tenantId, ciId])
  @@index([tenantId, timestamp])
}

// ── Monitoring ────────────────────────────────────────────────────────────────

model Event {
  id                  String    @id
  publicId            String    @unique
  tenantId            String
  type                String
  status              String
  severity            String
  title               String
  message             String
  source              String
  ruleId              String?
  rulePublicId        String?
  ruleName            String?
  affectedCIIds       String // JSON array
  affectedCIPublicIds String // JSON array
  correlationKey      String
  groupCount          Int       @default(1)
  firedAt             DateTime
  lastSeenAt          DateTime
  acknowledgedAt      DateTime?
  acknowledgedBy      String?
  resolvedAt          DateTime?
  resolvedBy          String?
  linkedIncidentId    String?
  payload             String    @default("{}") // JSON
  tags                String // JSON array
  applicationId       String?
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@index([tenantId, firedAt])
  @@index([tenantId, applicationId])
}

model MonitoringRule {
  id              String    @id
  publicId        String    @unique
  tenantId        String
  data            String // JSON — full rule snapshot; fields are heterogeneous per type
  enabled         Boolean   @default(true)
  lastTriggeredAt DateTime?
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, enabled])
}

model AlertRoute {
  id       String @id
  publicId String @unique
  tenantId String
  data     String // JSON
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ── Incidents ────────────────────────────────────────────────────────────────

model Incident {
  id                    String                  @id
  publicId              String                  @unique
  tenantId              String
  data                  String // JSON — full incident snapshot
  status                String
  priority              String
  severity              String
  isMajor               Boolean                 @default(false)
  linkedProblemPublicId String?
  affectedCIIds         String // JSON array (for filtering)
  affectedCIPublicIds   String // JSON array
  applicationId         String?
  createdAt             DateTime
  updatedAt             DateTime
  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comments              IncidentComment[]
  timeline              IncidentTimelineEvent[]

  @@index([tenantId, status])
  @@index([tenantId, isMajor])
  @@index([tenantId, linkedProblemPublicId])
  @@index([tenantId, applicationId])
}

model IncidentComment {
  id         String   @id
  tenantId   String
  incidentId String
  data       String // JSON
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([tenantId, incidentId])
}

model IncidentTimelineEvent {
  id         String   @id
  tenantId   String
  incidentId String
  kind       String
  timestamp  DateTime
  data       String // JSON
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([tenantId, incidentId])
}

// ── M3 domains (document-style: publicId + tenantId + JSON snapshot) ─────────
// Where the UI filters on a field (status/severity/etc.) we promote that
// column out of the JSON for indexed access. Everything else stays in `data`.

model Service {
  id       String @id
  tenantId String
  data     String

  @@index([tenantId])
}

model Problem {
  id        String   @id
  publicId  String   @unique
  tenantId  String
  status    String
  data      String
  createdAt DateTime @default(now())

  @@index([tenantId, status])
}

model Change {
  id             String    @id
  publicId       String    @unique
  tenantId       String
  status         String
  riskLevel      String?
  data           String
  scheduledStart DateTime?

  @@index([tenantId, status])
  @@index([tenantId, scheduledStart])
}

model Release {
  id       String @id
  publicId String @unique
  tenantId String
  status   String
  data     String

  @@index([tenantId, status])
}

model Deployment {
  id          String          @id
  publicId    String          @unique
  tenantId    String
  status      String
  environment String
  startedAt   DateTime?
  data        String
  logs        DeploymentLog[]

  @@index([tenantId, status])
}

model DeploymentLog {
  id           String     @id
  tenantId     String
  deploymentId String
  data         String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([tenantId, deploymentId])
}

model ServiceRequest {
  id       String @id
  publicId String @unique
  tenantId String
  status   String
  data     String

  @@index([tenantId, status])
}

model RequestComment {
  id        String   @id @default(cuid())
  tenantId  String
  requestId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([tenantId, requestId])
}

model CatalogItem {
  id       String @id
  tenantId String
  data     String

  @@index([tenantId])
}

model Integration {
  id       String  @id
  tenantId String
  enabled  Boolean @default(true)
  status   String
  data     String

  @@index([tenantId, enabled])
}

model KBArticle {
  id       String @id
  publicId String @unique
  tenantId String
  status   String
  data     String

  @@index([tenantId, status])
}

// ── Generic Document store ────────────────────────────────────────────────────
// Catch-all for small catalogs and snapshot data that doesn't need its own
// table. Keyed by (tenantId, kind, id). Lookups are list-by-kind and
// get-by-id; never query by inner JSON fields here — those domains stay as
// dedicated tables.

model Document {
  id        String   @id @default(cuid())
  tenantId  String
  kind      String // e.g. "outage", "sla-target", "ai-session"
  key       String? // optional secondary key (id from the source data)
  publicId  String?
  data      String // JSON
  position  Int      @default(0) // preserves seed ordering
  createdAt DateTime @default(now())

  @@unique([tenantId, kind, key])
  @@index([tenantId, kind])
  @@index([tenantId, kind, publicId])
}

// ── Audit log (cross-cutting; populated from M2 onwards) ──────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  actorId      String?
  action       String
  resourceKind String
  resourceId   String
  before       String? // JSON
  after        String? // JSON
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([tenantId, resourceKind, resourceId])
  @@index([tenantId, createdAt])
}

// ── AI session messages ───────────────────────────────────────────────────────

model AiMessage {
  id        String   @id @default(cuid())
  tenantId  String
  sessionId String
  role      String
  body      String
  createdAt DateTime @default(now())

  @@index([tenantId, sessionId])
}
