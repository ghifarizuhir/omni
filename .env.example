# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Application base URL.
APP_URL="MY_APP_URL"

# API mode switch: "live" hits the Express server, "mock" stays in-process.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api/v1
VITE_MOCK_LATENCY_MS=0
VITE_API_PROXY_TARGET=http://localhost:3001

# ── Backend (Express + Prisma) ────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0

# SQLite dev DB (M1). Production uses Postgres — swap the datasource provider
# in prisma/schema.prisma and point this to postgresql://…
DATABASE_URL=file:./prisma/dev.db
