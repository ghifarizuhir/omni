# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Application base URL.
APP_URL="MY_APP_URL"

VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:3001

# ── Backend (Express + Prisma) ────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0

# Postgres connection string. M7.4 docker-compose stands up a local Postgres
# at this URL; in staging/prod point this at the managed Postgres instance.
DATABASE_URL=postgresql://ois:ois@localhost:5432/ois?schema=public

# Frontend feature flag for the AppScopeSwitcher UX (Plan E).
# Set to "true" to enable in production builds. Operators can also flip
# it at runtime via localStorage.setItem('feature.app_scope_ui', 'true').
VITE_FEATURE_APP_SCOPE_UI=false

# Application-scope enforcement (Plan B-1+). Values: off | warn | enforce.
# - off (default): scope checks compute silently, never block.
# - warn: violation logged + X-Scope-Warning response header; request still succeeds.
# - enforce: violation → HTTP 403 scope_violation.
SCOPE_ENFORCEMENT_MODE=off
